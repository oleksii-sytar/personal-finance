# Forma — environment variables
# Copy to .env.local and fill in with YOUR OWN private Supabase project.
# Do not point this personal project at any shared/work infrastructure.

# Public (browser-exposed) Supabase config
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only service role key (optional for the auth shell; keep secret)
SUPABASE_SERVICE_KEY=

# App config
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
